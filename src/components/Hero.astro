---
---

<section id="top" class="relative overflow-hidden border-b border-rig-700 bg-rig-950">
  <div class="bg-diamond-plate absolute inset-0 [background-size:24px_24px] opacity-40"></div>
  <div class="relative mx-auto grid max-w-7xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-2 lg:items-center lg:px-8 lg:py-28">
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-ember-500">
        Custom Ford Fabrication &middot; Documented On Camera
      </p>
      <h1 class="mt-4 text-4xl font-extrabold uppercase leading-[1.05] tracking-tight text-zinc-50 sm:text-5xl lg:text-6xl">
        Real Fabrication.
        <span class="text-ember-500">No Shortcuts.</span>
        Filmed Start to Finish.
      </h1>
      <p class="mt-6 max-w-xl text-lg text-zinc-400">
        Front-clip swaps, chassis fabrication, and drivetrain conversions built by hand in the shop
        &mdash; and posted to YouTube unedited so you can see exactly how your truck gets built before
        you ever hand over the keys.
      </p>
      <div class="mt-10 flex flex-col gap-4 sm:flex-row">
        <a
          href="#quote"
          class="inline-flex items-center justify-center rounded-md bg-ember-600 px-8 py-4 font-mono text-sm font-bold uppercase tracking-wide text-rig-950 transition hover:bg-ember-500"
        >
          Request a Quote
        </a>
        <a
          href="https://www.youtube.com/@FrankinFord7379"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-md border border-rig-600 px-8 py-4 font-mono text-sm font-bold uppercase tracking-wide text-zinc-200 transition hover:border-ember-500 hover:text-ember-500"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true">
            <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.6 31.6 0 0 0 0 12a31.6 31.6 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.6 31.6 0 0 0 24 12a31.6 31.6 0 0 0-.5-5.8ZM9.6 15.5v-7l6.3 3.5-6.3 3.5Z"/>
          </svg>
          Watch on YouTube
        </a>
      </div>
      <dl class="mt-12 grid grid-cols-3 gap-6 border-t border-rig-700 pt-8">
        <div>
          <dt class="font-mono text-xs uppercase tracking-wide text-zinc-500">Builds Documented</dt>
          <dd class="mt-1 text-2xl font-extrabold text-zinc-50">50+</dd>
        </div>
        <div>
          <dt class="font-mono text-xs uppercase tracking-wide text-zinc-500">Specialty</dt>
          <dd class="mt-1 text-2xl font-extrabold text-zinc-50">Ford Trucks</dd>
        </div>
        <div>
          <dt class="font-mono text-xs uppercase tracking-wide text-zinc-500">Transparency</dt>
          <dd class="mt-1 text-2xl font-extrabold text-ember-500">100%</dd>
        </div>
      </dl>
    </div>

    <div class="relative flex items-center justify-center">
      <div class="absolute h-72 w-72 rounded-full bg-ember-600/10 blur-3xl"></div>
      <img
        src="/logo.jpg"
        alt="FrankinFord Fabrications hand-welded steel logo emblem"
        class="relative w-full max-w-md rounded-2xl border border-rig-600 object-cover shadow-2xl shadow-black/50"
      />
    </div>
  </div>
</section>
